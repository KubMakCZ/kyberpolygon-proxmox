# Appwrite Configuration
# Zkopírujte tento soubor jako .env a vyplňte skutečné hodnoty

# URL vašeho Appwrite serveru
# Příklady:
# - Appwrite Cloud: https://cloud.appwrite.io/v1
# - Vlastní server: https://appwrite.example.com/v1
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# ID vašeho Appwrite projektu
# Najdete ho v Appwrite konzoli v sekci Settings -> Project ID
VITE_APPWRITE_PROJECT_ID=your-project-id-here
